{
  "manifest_version": 3,
  "name": "Nimbus URL Shortener",
  "short_name": "Nimbus",
  "description": "Shorten long links from your Chrome toolbar or right-click menu, then copy and reuse recent short URLs.",
  "version": "1.4.0",
  "minimum_chrome_version": "109",
  "permissions": ["activeTab", "storage", "contextMenus", "notifications"],
  "host_permissions": ["https://nimbus-api-vqsz.onrender.com/*"],
  "icons": {
    "16": "icons/nimbus-16.png",
    "32": "icons/nimbus-32.png",
    "48": "icons/nimbus-48.png",
    "128": "icons/nimbus-128.png"
  },
  "action": {
    "default_title": "Shorten with Nimbus",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/nimbus-16.png",
      "32": "icons/nimbus-32.png",
      "48": "icons/nimbus-48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}