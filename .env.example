# Application
API_PORT=8080

# Public base URL used when generating shortened URLs
BASE_URL=http://localhost:8080

# Chrome extension origin
# Replace this with your real extension ID:
# chrome-extension://YOUR_EXTENSION_ID
EXTENSION_ORIGIN=chrome-extension://YOUR_EXTENSION_ID

# Rate limiting
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# PostgreSQL
DB_URL=postgres://nimbus:nimbuspass@postgres:5432/nimbus?sslmode=disable

# Redis
REDIS_URL=redis://redis:6379

# PostgreSQL container configuration
POSTGRES_USER=nimbus
POSTGRES_PASSWORD=nimbuspass
POSTGRES_DB=nimbus
POSTGRES_PORT=5432

# Redis container configuration
REDIS_PORT=6379